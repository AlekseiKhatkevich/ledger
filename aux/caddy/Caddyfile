{
    debug
    grace_period 10s
    order jwtauth before basicauth
}

(keykloack_healthcheck) {
    health_uri /health/ready
    health_interval 10s
    health_timeout 2s
    health_port 9000
}

(ledger_healthcheck) {
    health_uri /aux/health
    health_interval 5s
    health_timeout 1s
}

(headers_for_keycloak) {
    header_up X-Forwarded-For {remote}
#   as backend uses http connection to KeyCloak internally we have 2 use it too here
#   in order to have same ISS field inside JWT
    header_up X-Forwarded-Proto http

    header_up X-Forwarded-Host {$KEYCLOAK_DOMAIN}

    header_up X-Forwarded-Port {$KEYCLOAK_PORT}

}

(ledger_reverce_proxy) {
    reverse_proxy backend-api:8000 {
            import ledger_healthcheck
                }
            }

(handle_401_error) {
    handle_errors 401 {
        @jwt_expired {
            vars {http.auth.jwt.error} `"exp" not satisfied`
        }
        @jwt_invalid_signature {
            vars {http.auth.jwt.error} "invalid signature"
        }
        @jwt_invalid_audience {
            vars {http.auth.jwt.error} "invalid audience"
        }

        route {
            respond @jwt_expired `{"error":"token_expired","message":"JWT token has expired. Please refresh your token."}` 401
            respond @jwt_invalid_signature `{"error":"invalid_signature","message":"JWT signature is invalid."}` 401
            respond @jwt_invalid_audience `{"error":"invalid_audience","message":"JWT audience is invalid."}` 401
            respond * `{"error":"unauthorized","message":"Authentication required. Please provide a valid JWT token."}` 401
        }
    }
}

# Caddy self healthcheck
:8001 {
    @ready path /_caddy_ready
    handle @ready {
    respond "ok" 200
}
}

# ledger backend
:8000 {
    vars {
            KC_BASE_URL /realms/{$KEYCLOACK_LEDGER_REALM}/protocol/openid-connect
        }

#    tls /etc/caddy/ncert.pem /etc/caddy/nkey.pem

    # STATIC FILES
    @static {
        path /error-descriptions/* /assets/*
        method GET HEAD
        }

    handle @static {
        root * /srv
        file_server {
            hide /error-descriptions/templates/*
            }
        }

    # S3 files
    handle_path /ext-files/* {
        rewrite * /{$S3_EXT_FILES_BUCKET}{path}
        reverse_proxy http://minio:9000
    }

    @login+refresh {
        method POST
        path /user/login /user/refresh
    }
#   Proxying token sourcing and refreshing to keykloack endpoint. Both operation use same EP.
    handle @login+refresh {
        rewrite * {vars.KC_BASE_URL}/token

        reverse_proxy keycloak:8080 {
            import keykloack_healthcheck
            import headers_for_keycloak
            }
        }

    @exclude_from_auth {
        method GET HEAD TRACE
        path /aux/health /docs
    }
    handle @exclude_from_auth {
        import ledger_reverce_proxy
    }

    @userinfo {
        method GET
        path /user
    }
    handle @userinfo {
       reverse_proxy keycloak:8080 {
           rewrite {vars.KC_BASE_URL}/userinfo
           import headers_for_keycloak
        }
    }


    handle * {
         jwtauth {
            jwk_url http://keycloak:8080{vars.KC_BASE_URL}/certs
            issuer_whitelist {$KC_ISSUER_WHITELIST}
            audience_whitelist {$KC_AUDIENCE_WHITELIST}
        }

        reverse_proxy backend-api:8000 {
                    import ledger_healthcheck
                    lb_policy header Bearer {
                        fallback least_conn
                        }
                    }
    }

    import handle_401_error
}
