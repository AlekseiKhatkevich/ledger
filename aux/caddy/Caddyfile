{
    debug
    grace_period 10s
}

(keykloack_healthcheck) {
    health_uri /health/ready
    health_interval 10s
    health_timeout 2s
    health_port 9000
}

(ledger_healthcheck) {
    health_uri /aux/health
    health_interval 5s
    health_timeout 1s
}

# Caddy self healthcheck
:8001 {
    @ready path /_caddy_ready
    handle @ready {
    respond "ok" 200
}
}

# ledger backend
:8000 {
    @login path /user/login

#   Proxying token sourcing to keykloack endpoint
    handle @login {
        rewrite * /realms/test/protocol/openid-connect/token
        reverse_proxy keycloak:8080 {
#
                header_up X-Forwarded-For "{remote}"
#
                header_up X-Forwarded-Proto "{scheme}"
#
#                header_up X-Forwarded-Host "{host}"
            header_up X-Forwarded-Host keycloak
                header_up X-Forwarded-Port "8080"
#

}
        }

    handle * {
        reverse_proxy backend-api:8000 {
            import ledger_healthcheck
                }
            }
}

# all keycloak (amin, etc))
:8080, :8443 {
    reverse_proxy keycloak:8080 {
    import keykloack_healthcheck
}
}