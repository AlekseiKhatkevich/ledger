{
    debug
    grace_period 10s
    order jwtauth before basicauth
    order rate_limit after jwtauth
}

# ── Healthcheck ──────────────────────────────────────────

(keykloack_healthcheck) {
    health_uri      /health/ready
    health_interval 10s
    health_timeout  2s
    health_port     9000
}

(ledger_healthcheck) {
    health_uri      /aux/health
    health_interval 5s
    health_timeout  1s
}

# ── Authentication helpers ──────────────────────────────

(headers_for_keycloak) {
    header_up X-Forwarded-For   {remote}
    # As backend uses HTTP connection to Keycloak internally we have to use it too here
    # in order to have same ISS field inside JWT
    header_up X-Forwarded-Proto http
    header_up X-Forwarded-Host {$KEYCLOAK_DOMAIN}
    header_up X-Forwarded-Port {$KEYCLOAK_PORT}
}

(handle_401_error) {
    handle_errors 401 {
        @jwt_expired {
            vars {http.auth.jwt.error} `"exp" not satisfied`
        }
        @jwt_invalid_signature {
            vars {http.auth.jwt.error} "invalid signature"
        }
        @jwt_invalid_audience {
            vars {http.auth.jwt.error} "invalid audience"
        }

        route {
            respond @jwt_expired \
                `{"error":"token_expired","message":"JWT token has expired. Please refresh your token."}` 401
            respond @jwt_invalid_signature \
                `{"error":"invalid_signature","message":"JWT signature is invalid."}` 401
            respond @jwt_invalid_audience \
                `{"error":"invalid_audience","message":"JWT audience is invalid."}` 401
            respond * \
                `{"error":"unauthorized","message":"Authentication required. Please provide a valid JWT token."}` 401
        }
    }
}

# ── Reverse proxy ────────────────────────────────────────

(ledger_reverse_proxy) {
    reverse_proxy backend-api:8000 {
        import ledger_healthcheck
    }
}

# ── Infrastructure ──────────────────────────────────────

(basic_tracing) {
    tracing {
        span "{method} {path}"
        span_attributes {
            user_id           {http.auth.user.id}
            rate_limit_zone   {http.rate_limit.exceeded.name}
            trace_id          {http.vars.trace_id}
            span_id           {http.vars.span_id}
            query_params      {http.request.orig_uri.query}
        }
    }
}

(rate_limit_by_ip) {
    rate_limit {
        zone {args[0]} {
            key     {remote_host}
            events  {args[1]}
            window  {args[2]}
        }
        log_key
        jitter 0.1
    }
}

(rate_limit_by_jwt) {
    rate_limit {
        zone {args[0]} {
            key     {http.auth.user.id}
            events  {args[1]}
            window  {args[2]}
        }
        log_key
        jitter 0.1
    }
}

# ── Site definitions ───────────────────────────────────

# Caddy self healthcheck
:8001 {
    @ready path /_caddy_ready
    handle @ready {
        respond "ok" 200
    }
}

# Ledger backend
:8000 {
    import basic_tracing
    import handle_401_error

    vars {
        KC_BASE_URL /realms/{$KEYCLOACK_LEDGER_REALM}/protocol/openid-connect
    }

    # STATIC FILES
    @static {
        path    /error-descriptions/* /assets/*
        method  GET HEAD
    }
    handle @static {
        root * /srv

        import rate_limit_by_ip static_per_ip_3s 500 3s

        file_server {
            hide /error-descriptions/templates/*
        }
    }

    # S3 files
    handle_path /ext-files/* {
        rewrite * /{$S3_EXT_FILES_BUCKET}{path}

        import rate_limit_by_ip extfiles_per_ip_5s 500 5s

        reverse_proxy http://minio:9000
    }

    @login+refresh {
        method  POST
        path    /user/login /user/refresh
    }
    # Proxying token sourcing and refreshing to keycloak endpoint. Both operation use same EP.
    handle @login+refresh {
        rewrite * {vars.KC_BASE_URL}/token

        import rate_limit_by_ip auth_per_ip_1m 20 1m

        reverse_proxy keycloak:8080 {
            import keykloack_healthcheck
            import headers_for_keycloak
        }
    }

    @exclude_from_auth {
        method  GET HEAD TRACE
        path    /aux/health /docs
    }
    handle @exclude_from_auth {
        import rate_limit_by_ip health_per_ip_1m 120 1m
        import ledger_reverse_proxy
    }

    @userinfo {
        method  GET
        path    /user
    }
    handle @userinfo {
        import rate_limit_by_ip userinfo_per_ip_1m 20 1m

        reverse_proxy keycloak:8080 {
            rewrite {vars.KC_BASE_URL}/userinfo
            import headers_for_keycloak
        }
    }

    handle * {
        jwtauth {
            jwk_url             http://keycloak:8080{vars.KC_BASE_URL}/certs
            issuer_whitelist    {$KC_ISSUER_WHITELIST}
            audience_whitelist  {$KC_AUDIENCE_WHITELIST}
        }

        import rate_limit_by_jwt jwt_per_user_1m 300 1m
        import rate_limit_by_jwt jwt_per_user_5s 70 5s

        reverse_proxy backend-api:8000 {
            import ledger_healthcheck
            lb_policy header X-User-Id {
                fallback least_conn
            }
            header_up X-User-Id {http.auth.user.id}
        }
    }
}